{
  "runtime": {
    "nodeMinMajor": 20
  },
  "processLevels": {
    "lite": {
      "when": "one user, no money or personal data, 1 to 3 epics",
      "spike": "optional",
      "spikeRequired": false,
      "planReview": "short checklist, no pre-mortem",
      "planReviewRounds": {
        "ownerDecidesAtReject": 2,
        "maxRounds": 3
      },
      "planReviewNotes": "implementers",
      "preMortemReasons": 0,
      "staging": "local build",
      "productionSmoke": false,
      "decisions": {
        "askOwner": {
          "min": 3,
          "max": 5
        },
        "restMayBeTwoWay": true
      },
      "epics": {
        "max": 3
      }
    },
    "standard": {
      "when": "users, a database, auth, a deployment",
      "spike": "when an assumption is unproven",
      "spikeRequired": false,
      "planReview": "full checklist, pre-mortem with 5 reasons",
      "planReviewNotes": "owner",
      "preMortemReasons": 5,
      "staging": "required",
      "productionSmoke": true,
      "decisions": {
        "askOwner": "all",
        "restMayBeTwoWay": false
      }
    },
    "full": {
      "when": "several services, realtime, payments, AI pipelines, a high cost of error",
      "spike": "required",
      "spikeRequired": true,
      "planReview": "full checklist, pre-mortem with 10 reasons",
      "planReviewNotes": "owner",
      "preMortemReasons": 10,
      "staging": "required",
      "productionSmoke": true,
      "decisions": {
        "askOwner": "all",
        "restMayBeTwoWay": false
      }
    }
  },
  "riskClasses": {
    "appliesAt": "every process level",
    "low": {
      "examples": "UI, copy",
      "implementer": "implementer",
      "effort": "high",
      "merge": "auto"
    },
    "normal": {
      "examples": "ordinary logic",
      "implementer": "implementer",
      "effort": "high",
      "merge": "auto"
    },
    "high": {
      "examples": "auth, payments, data migrations and deletion, infrastructure, security",
      "implementer": "implementer-deep",
      "effort": "xhigh",
      "merge": "owner"
    }
  },
  "budgets": {
    "subagentToolCalls": {
      "warn": 100,
      "stop": 120
    },
    "researcherToolCalls": {
      "lite": {
        "warn": 30,
        "stop": 40
      },
      "standard": {
        "warn": 60,
        "stop": 80
      },
      "full": {
        "warn": 100,
        "stop": 120
      }
    },
    "sessionToolCalls": {
      "warn": 250,
      "stop": 300
    },
    "epicsPerSession": 3,
    "implementersPerChange": 3
  },
  "hooks": {
    "briefMaxChars": 2000,
    "stopRetries": 2,
    "gateTimeoutSeconds": {
      "fast": 120,
      "changed": 540
    },
    "gateOutputChars": 3000,
    "reviewers": [
      "pitwall:plan-reviewer",
      "pitwall:code-reviewer",
      "pitwall:qa"
    ],
    "implementers": [
      "pitwall:implementer",
      "pitwall:implementer-deep"
    ],
    "agents": {
      "pitwall:plan-reviewer": {
        "write": [
          "docs/PLAN-REVIEW.md"
        ],
        "run": [
          "docs-check.mjs",
          "review-status.mjs"
        ],
        "review": "plan"
      },
      "pitwall:code-reviewer": {
        "write": [
          "docs/reviews/*.md"
        ],
        "run": [
          "docs-check.mjs",
          "review-status.mjs"
        ],
        "git": ["diff", "log", "show", "status", "rev-parse", "ls-files", "blame", "merge-base", "branch"],
        "gate": true,
        "review": "code"
      },
      "pitwall:qa": {
        "write": [
          "docs/reviews/release-*.md"
        ],
        "run": [
          "release.mjs",
          "bugs.mjs",
          "docs-check.mjs",
          "review-status.mjs"
        ],
        "git": ["diff", "log", "show", "status", "rev-parse", "ls-files", "merge-base", "branch"],
        "gate": true,
        "review": "release"
      }
    },
    "ownerOnly": [
      "merge-choice.mjs"
    ],
    "noPromptModes": [
      "bypassPermissions",
      "dontAsk"
    ],
    "ownerPromptMinutes": 60,
    "ownerPromptNote": "pitwall/owner-prompt.json",
    "handback": [
      "SubagentHandback"
    ],
    "secrets": {
      "files": [
        ".env",
        ".env.*",
        "*.pem",
        "*.key",
        "*.p12",
        "*.pfx",
        "id_rsa",
        "id_dsa",
        "id_ecdsa",
        "id_ed25519"
      ],
      "notSecret": [
        ".env.example"
      ],
      "content": [
        "-----BEGIN [A-Z ]*PRIVATE KEY-----\\s+[A-Za-z0-9+/=]{40,}",
        "\\bAKIA[0-9A-Z]{16}\\b",
        "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b",
        "\\bgithub_pat_[A-Za-z0-9_]{50,}\\b",
        "\\bxox[abprs]-[A-Za-z0-9-]{10,}\\b",
        "\\bsk-ant-[A-Za-z0-9_-]{20,}\\b",
        "\\bsk-(?:proj-)?[A-Za-z0-9_-]{32,}\\b",
        "\\bAIza[0-9A-Za-z_-]{35}\\b",
        "\\b[rs]k_live_[0-9A-Za-z]{20,}\\b"
      ]
    },
    "readOnlyCommands": [
      "cat", "head", "tail", "less", "more", "grep", "egrep", "fgrep", "rg", "wc", "ls", "stat", "file", "diff", "cmp", "jq",
      "sha256sum", "sha1sum", "md5sum", "test", "[", "[[", "echo", "printf",
      "get-content", "gc", "type", "select-string", "sls", "test-path", "get-item", "gi", "get-childitem", "gci", "dir", "get-filehash"
    ],
    "readOnlyGit": [
      "diff", "log", "show", "status", "add", "blame", "ls-files", "cat-file", "rev-parse", "check-ignore"
    ]
  },
  "review": {
    "statusContext": "ai-review",
    "gateContext": "gate",
    "runs": "local session",
    "ownerDecidesAtReject": 3,
    "maxRounds": 5,
    "findings": {
      "realistic": "what an honest agent or person could write or do by accident while following the process: it may block",
      "exotic": "what only a deliberate attempt to get past a check would write, such as invisible characters, HTML or character references in cells, or Markdown built to read one way and render another: listed once, kept as one accepted risk, never blocking"
    },
    "threatModel": "the checks guard against mistakes and carelessness, not against a deliberate bypass; the reviewer and the owner's approval catch that"
  },
  "kickoff": {
    "questions": {
      "min": 3,
      "max": 5
    }
  },
  "mergeProtection": {
    "public": "branch protection with required checks, admins included; also private repositories on a paid plan",
    "privateFree": "mode local-hook: a local hook refuses the merge until both checks are green",
    "branch": "main",
    "enforceAdmins": true,
    "strict": false,
    "githubActionsAppId": 15368,
    "modes": [
      "pending",
      "branch-protection",
      "local-hook"
    ]
  },
  "planning": {
    "branch": "plan/initial"
  },
  "bugs": {
    "severities": {
      "blocking": "the defect itself does harm in ordinary work: work stops, or data, work or a secret is lost because of it; its fix goes before the next epic",
      "not blocking": "anything else, a gap in a protection that does harm only after someone else's mistake included; its fix waits until no epic is ready"
    },
    "unconfirmed": {
      "mark": "unconfirmed",
      "severity": "blocking"
    },
    "oldTable": {
      "severity": "blocking",
      "risk": "high"
    },
    "foundIn": [
      "QA",
      "review",
      "production",
      "owner",
      "CI"
    ],
    "statuses": [
      "open",
      "in progress",
      "in review",
      "fixed",
      "accepted"
    ],
    "pending": {
      "bugs": "pitwall/bugs.md",
      "risks": "pitwall/risks.md",
      "lessons": "pitwall/lessons.md"
    }
  },
  "loop": {
    "branches": {
      "epic": "epic/",
      "fix": "fix/",
      "release": "release/"
    },
    "reviews": "docs/reviews",
    "severities": [
      "blocking",
      "should fix"
    ],
    "ownerChoice": "autoMerge"
  },
  "release": {
    "tagPrefix": "v",
    "changelog": "CHANGELOG.md",
    "build": "scripts/build",
    "artifactLine": "ARTIFACT:",
    "firstVersions": [
      "0.1.0",
      "1.0.0"
    ],
    "status": "released",
    "pending": "pitwall/release",
    "subject": "release"
  },
  "discovery": {
    "scenarios": {
      "min": 3,
      "max": 7
    },
    "analogues": {
      "min": 5,
      "max": 10
    },
    "researchers": {
      "min": 2,
      "max": 3
    },
    "constraints": [
      "Monthly budget",
      "Platforms",
      "Hosting",
      "Personal data",
      "Licence",
      "Time for reviews"
    ],
    "riskOrder": [
      "high",
      "medium",
      "low"
    ]
  },
  "decide": {
    "options": {
      "min": 2,
      "max": 4
    },
    "areas": [
      "Platform and runtime",
      "Language",
      "Framework",
      "Database",
      "Data model",
      "Auth",
      "Repository layout",
      "Monolith or services",
      "Folder structure and module boundaries",
      "Architecture patterns",
      "API",
      "Client state",
      "UI kit",
      "Lint and format",
      "Test strategy",
      "CI/CD",
      "Hosting and staging",
      "Observability",
      "i18n",
      "Accessibility",
      "AI models and external APIs"
    ],
    "oneWay": [
      "Platform and runtime",
      "Language",
      "Framework",
      "Database",
      "Data model",
      "Auth",
      "Repository layout",
      "Monolith or services",
      "Hosting and staging"
    ],
    "notNeeded": "Not needed"
  },
  "spike": {
    "branch": "spike/<topic>",
    "outcomes": [
      "confirmed",
      "not confirmed"
    ],
    "pending": "pending"
  },
  "plan": {
    "firstEpic": "E0",
    "status": "planned",
    "statuses": [
      "planned",
      "in progress",
      "in review",
      "merged",
      "released"
    ],
    "epicSplit": {
      "modules": 3,
      "packages": 2
    },
    "gateWaitSeconds": 90
  },
  "planReview": {
    "nonFunctional": [
      {
        "item": "Security and secrets",
        "levels": [
          "lite",
          "standard",
          "full"
        ]
      },
      {
        "item": "Personal data and GDPR",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "Monthly cost at 10 and 1000 users",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "Dependency licences",
        "levels": [
          "lite",
          "standard",
          "full"
        ]
      },
      {
        "item": "Accessibility",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "i18n",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "Logs, metrics and alerts",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "Backups and restore",
        "levels": [
          "lite",
          "standard",
          "full"
        ]
      },
      {
        "item": "Performance targets",
        "levels": [
          "lite",
          "standard",
          "full"
        ]
      },
      {
        "item": "External API limits",
        "levels": [
          "standard",
          "full"
        ]
      }
    ],
    "launch": [
      {
        "item": "Domain",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "Hosting",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "App stores",
        "levels": [
          "lite",
          "standard",
          "full"
        ]
      },
      {
        "item": "Legal pages",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "Analytics with consent",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "Support channel",
        "levels": [
          "lite",
          "standard",
          "full"
        ]
      }
    ],
    "sizes": [
      "S",
      "M",
      "L"
    ],
    "uncertainty": [
      "known",
      "partly",
      "unknown"
    ],
    "needsAction": {
      "sizes": [
        "L"
      ],
      "uncertainty": [
        "unknown"
      ]
    },
    "severities": [
      "blocking",
      "should fix"
    ],
    "open": "open"
  },
  "maturity": {
    "stableReleaseOnly": true,
    "maxMonthsSinceLastRelease": 6
  },
  "registries": {
    "npm": {
      "url": "https://registry.npmjs.org/-/v1/search?text=<package>&size=1",
      "name": "objects[0].package.name",
      "version": "objects[0].package.version",
      "date": "objects[0].package.date"
    },
    "pypi": {
      "url": "https://pypi.org/pypi/<package>/json",
      "version": "info.version",
      "date": "urls[0].upload_time"
    },
    "crates": {
      "url": "https://crates.io/api/v1/crates/<crate>",
      "version": "crate.max_stable_version",
      "date": "versions[] entry whose num is crate.max_stable_version: created_at"
    },
    "go": {
      "url": "https://proxy.golang.org/<module>/@latest",
      "version": "Version",
      "date": "Time"
    },
    "runtimes": {
      "url": "https://endoflife.date/api/<product>.json",
      "version": "[0].latest",
      "date": "[0].latestReleaseDate"
    }
  },
  "docsLimits": {
    "claudeMdMaxLines": 200,
    "stateFileMaxKB": 50,
    "stateFiles": [
      "docs/EPICS.md",
      "docs/BUGS.md",
      "docs/LESSONS.md",
      "docs/JOURNAL.md",
      "docs/RISKS.md"
    ],
    "optionalSections": {
      "docs/PLAN-REVIEW.md": [
        "Notes for the implementers"
      ]
    }
  },
  "rag": {
    "projectDocsThresholdKB": 1024
  }
}
