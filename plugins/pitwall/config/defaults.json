{
  "processLevels": {
    "lite": {
      "when": "one user, no money or personal data, 1 to 3 epics",
      "spike": "optional",
      "planReview": "short checklist",
      "staging": "local build",
      "productionSmoke": false
    },
    "standard": {
      "when": "users, a database, auth, a deployment",
      "spike": "when an assumption is unproven",
      "planReview": "full",
      "staging": "required",
      "productionSmoke": true
    },
    "full": {
      "when": "several services, realtime, payments, AI pipelines, a high cost of error",
      "spike": "required",
      "planReview": "full with pre-mortem",
      "staging": "required",
      "productionSmoke": true
    }
  },
  "riskClasses": {
    "appliesAt": "every process level",
    "low": { "examples": "UI, copy", "implementer": "implementer", "effort": "high", "merge": "auto" },
    "normal": { "examples": "ordinary logic", "implementer": "implementer", "effort": "high", "merge": "auto" },
    "high": {
      "examples": "auth, payments, data migrations and deletion, infrastructure, security",
      "implementer": "implementer-deep",
      "effort": "xhigh",
      "merge": "owner"
    }
  },
  "budgets": {
    "subagentToolCalls": { "warn": 100, "stop": 120 },
    "sessionToolCalls": { "warn": 250, "stop": 300 },
    "epicsPerSession": 3
  },
  "review": {
    "statusContext": "ai-review",
    "gateContext": "gate",
    "runs": "local session",
    "ownerDecidesAtReject": 3
  },
  "mergeProtection": {
    "public": "branch protection with required checks",
    "privateFree": "local hook refuses merge until checks are green"
  },
  "maturity": {
    "stableReleaseOnly": true,
    "maxMonthsSinceLastRelease": 6
  },
  "docsLimits": {
    "claudeMdMaxLines": 200,
    "stateFileMaxKB": 50
  },
  "rag": {
    "projectDocsThresholdKB": 1024
  }
}
