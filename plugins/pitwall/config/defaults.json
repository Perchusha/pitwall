{
  "runtime": {
    "nodeMinMajor": 20
  },
  "processLevels": {
    "lite": {
      "when": "one user, no money or personal data, 1 to 3 epics",
      "spike": "optional",
      "planReview": "short checklist",
      "staging": "local build",
      "productionSmoke": false
    },
    "standard": {
      "when": "users, a database, auth, a deployment",
      "spike": "when an assumption is unproven",
      "planReview": "full",
      "staging": "required",
      "productionSmoke": true
    },
    "full": {
      "when": "several services, realtime, payments, AI pipelines, a high cost of error",
      "spike": "required",
      "planReview": "full with pre-mortem",
      "staging": "required",
      "productionSmoke": true
    }
  },
  "riskClasses": {
    "appliesAt": "every process level",
    "low": {
      "examples": "UI, copy",
      "implementer": "implementer",
      "effort": "high",
      "merge": "auto"
    },
    "normal": {
      "examples": "ordinary logic",
      "implementer": "implementer",
      "effort": "high",
      "merge": "auto"
    },
    "high": {
      "examples": "auth, payments, data migrations and deletion, infrastructure, security",
      "implementer": "implementer-deep",
      "effort": "xhigh",
      "merge": "owner"
    }
  },
  "budgets": {
    "subagentToolCalls": {
      "warn": 100,
      "stop": 120
    },
    "sessionToolCalls": {
      "warn": 250,
      "stop": 300
    },
    "epicsPerSession": 3
  },
  "review": {
    "statusContext": "ai-review",
    "gateContext": "gate",
    "runs": "local session",
    "ownerDecidesAtReject": 3
  },
  "mergeProtection": {
    "public": "branch protection with required checks, admins included; also private repositories on a paid plan",
    "privateFree": "mode local-hook: a local hook refuses the merge until both checks are green",
    "branch": "main",
    "enforceAdmins": true,
    "strict": false,
    "githubActionsAppId": 15368,
    "modes": [
      "pending",
      "branch-protection",
      "local-hook"
    ]
  },
  "planning": {
    "branch": "plan/initial"
  },
  "discovery": {
    "scenarios": {
      "min": 3,
      "max": 7
    },
    "analogues": {
      "min": 5,
      "max": 10
    },
    "researchers": {
      "min": 2,
      "max": 3
    },
    "constraints": [
      "Monthly budget",
      "Platforms",
      "Hosting",
      "Personal data",
      "Licence",
      "Time for reviews"
    ],
    "riskOrder": [
      "high",
      "medium",
      "low"
    ]
  },
  "decide": {
    "options": {
      "min": 2,
      "max": 4
    },
    "areas": [
      "Platform and runtime",
      "Language",
      "Framework",
      "Database",
      "Data model",
      "Auth",
      "Repository layout",
      "Monolith or services",
      "Folder structure and module boundaries",
      "Architecture patterns",
      "API",
      "Client state",
      "UI kit",
      "Lint and format",
      "Test strategy",
      "CI/CD",
      "Hosting and staging",
      "Observability",
      "i18n",
      "Accessibility",
      "AI models and external APIs"
    ],
    "oneWay": [
      "Platform and runtime",
      "Language",
      "Framework",
      "Database",
      "Data model",
      "Auth",
      "Repository layout",
      "Monolith or services",
      "Hosting and staging"
    ],
    "notNeeded": "Not needed"
  },
  "maturity": {
    "stableReleaseOnly": true,
    "maxMonthsSinceLastRelease": 6
  },
  "registries": {
    "npm": "https://registry.npmjs.org/<package>/latest",
    "pypi": "https://pypi.org/pypi/<package>/json",
    "crates": "https://crates.io/api/v1/crates/<crate>",
    "go": "https://proxy.golang.org/<module>/@latest",
    "runtimes": "https://endoflife.date/api/<product>.json"
  },
  "docsLimits": {
    "claudeMdMaxLines": 200,
    "stateFileMaxKB": 50,
    "stateFiles": [
      "docs/EPICS.md",
      "docs/BUGS.md",
      "docs/LESSONS.md",
      "docs/JOURNAL.md",
      "docs/RISKS.md"
    ]
  },
  "rag": {
    "projectDocsThresholdKB": 1024
  }
}
