{
  "runtime": {
    "nodeMinMajor": 20
  },
  "processLevels": {
    "lite": {
      "when": "one user, no money or personal data, 1 to 3 epics",
      "spike": "optional",
      "spikeRequired": false,
      "planReview": "short checklist, no pre-mortem",
      "preMortemReasons": 0,
      "staging": "local build",
      "productionSmoke": false,
      "decisions": {
        "askOwner": {
          "min": 3,
          "max": 5
        },
        "restMayBeTwoWay": true
      },
      "epics": {
        "max": 3
      }
    },
    "standard": {
      "when": "users, a database, auth, a deployment",
      "spike": "when an assumption is unproven",
      "spikeRequired": false,
      "planReview": "full checklist, pre-mortem with 5 reasons",
      "preMortemReasons": 5,
      "staging": "required",
      "productionSmoke": true,
      "decisions": {
        "askOwner": "all",
        "restMayBeTwoWay": false
      }
    },
    "full": {
      "when": "several services, realtime, payments, AI pipelines, a high cost of error",
      "spike": "required",
      "spikeRequired": true,
      "planReview": "full checklist, pre-mortem with 10 reasons",
      "preMortemReasons": 10,
      "staging": "required",
      "productionSmoke": true,
      "decisions": {
        "askOwner": "all",
        "restMayBeTwoWay": false
      }
    }
  },
  "riskClasses": {
    "appliesAt": "every process level",
    "low": {
      "examples": "UI, copy",
      "implementer": "implementer",
      "effort": "high",
      "merge": "auto"
    },
    "normal": {
      "examples": "ordinary logic",
      "implementer": "implementer",
      "effort": "high",
      "merge": "auto"
    },
    "high": {
      "examples": "auth, payments, data migrations and deletion, infrastructure, security",
      "implementer": "implementer-deep",
      "effort": "xhigh",
      "merge": "owner"
    }
  },
  "budgets": {
    "subagentToolCalls": {
      "warn": 100,
      "stop": 120
    },
    "researcherToolCalls": {
      "lite": {
        "warn": 30,
        "stop": 40
      },
      "standard": {
        "warn": 60,
        "stop": 80
      },
      "full": {
        "warn": 100,
        "stop": 120
      }
    },
    "sessionToolCalls": {
      "warn": 250,
      "stop": 300
    },
    "epicsPerSession": 3
  },
  "review": {
    "statusContext": "ai-review",
    "gateContext": "gate",
    "runs": "local session",
    "ownerDecidesAtReject": 3
  },
  "kickoff": {
    "questions": {
      "min": 3,
      "max": 5
    }
  },
  "mergeProtection": {
    "public": "branch protection with required checks, admins included; also private repositories on a paid plan",
    "privateFree": "mode local-hook: a local hook refuses the merge until both checks are green",
    "branch": "main",
    "enforceAdmins": true,
    "strict": false,
    "githubActionsAppId": 15368,
    "modes": [
      "pending",
      "branch-protection",
      "local-hook"
    ]
  },
  "planning": {
    "branch": "plan/initial"
  },
  "discovery": {
    "scenarios": {
      "min": 3,
      "max": 7
    },
    "analogues": {
      "min": 5,
      "max": 10
    },
    "researchers": {
      "min": 2,
      "max": 3
    },
    "constraints": [
      "Monthly budget",
      "Platforms",
      "Hosting",
      "Personal data",
      "Licence",
      "Time for reviews"
    ],
    "riskOrder": [
      "high",
      "medium",
      "low"
    ]
  },
  "decide": {
    "options": {
      "min": 2,
      "max": 4
    },
    "areas": [
      "Platform and runtime",
      "Language",
      "Framework",
      "Database",
      "Data model",
      "Auth",
      "Repository layout",
      "Monolith or services",
      "Folder structure and module boundaries",
      "Architecture patterns",
      "API",
      "Client state",
      "UI kit",
      "Lint and format",
      "Test strategy",
      "CI/CD",
      "Hosting and staging",
      "Observability",
      "i18n",
      "Accessibility",
      "AI models and external APIs"
    ],
    "oneWay": [
      "Platform and runtime",
      "Language",
      "Framework",
      "Database",
      "Data model",
      "Auth",
      "Repository layout",
      "Monolith or services",
      "Hosting and staging"
    ],
    "notNeeded": "Not needed"
  },
  "spike": {
    "branch": "spike/<topic>",
    "outcomes": [
      "confirmed",
      "not confirmed"
    ],
    "pending": "pending"
  },
  "plan": {
    "firstEpic": "E0",
    "status": "planned",
    "statuses": [
      "planned",
      "in progress",
      "in review",
      "merged",
      "released"
    ]
  },
  "planReview": {
    "nonFunctional": [
      {
        "item": "Security and secrets",
        "levels": [
          "lite",
          "standard",
          "full"
        ]
      },
      {
        "item": "Personal data and GDPR",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "Monthly cost at 10 and 1000 users",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "Dependency licences",
        "levels": [
          "lite",
          "standard",
          "full"
        ]
      },
      {
        "item": "Accessibility",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "i18n",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "Logs, metrics and alerts",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "Backups and restore",
        "levels": [
          "lite",
          "standard",
          "full"
        ]
      },
      {
        "item": "Performance targets",
        "levels": [
          "lite",
          "standard",
          "full"
        ]
      },
      {
        "item": "External API limits",
        "levels": [
          "standard",
          "full"
        ]
      }
    ],
    "launch": [
      {
        "item": "Domain",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "Hosting",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "App stores",
        "levels": [
          "lite",
          "standard",
          "full"
        ]
      },
      {
        "item": "Legal pages",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "Analytics with consent",
        "levels": [
          "standard",
          "full"
        ]
      },
      {
        "item": "Support channel",
        "levels": [
          "lite",
          "standard",
          "full"
        ]
      }
    ],
    "sizes": [
      "S",
      "M",
      "L"
    ],
    "uncertainty": [
      "known",
      "partly",
      "unknown"
    ],
    "needsAction": {
      "sizes": [
        "L"
      ],
      "uncertainty": [
        "unknown"
      ]
    },
    "severities": [
      "blocking",
      "should fix"
    ],
    "open": "open"
  },
  "maturity": {
    "stableReleaseOnly": true,
    "maxMonthsSinceLastRelease": 6
  },
  "registries": {
    "npm": {
      "url": "https://registry.npmjs.org/-/v1/search?text=<package>&size=1",
      "name": "objects[0].package.name",
      "version": "objects[0].package.version",
      "date": "objects[0].package.date"
    },
    "pypi": {
      "url": "https://pypi.org/pypi/<package>/json",
      "version": "info.version",
      "date": "urls[0].upload_time"
    },
    "crates": {
      "url": "https://crates.io/api/v1/crates/<crate>",
      "version": "crate.max_stable_version",
      "date": "versions[] entry whose num is crate.max_stable_version: created_at"
    },
    "go": {
      "url": "https://proxy.golang.org/<module>/@latest",
      "version": "Version",
      "date": "Time"
    },
    "runtimes": {
      "url": "https://endoflife.date/api/<product>.json",
      "version": "[0].latest",
      "date": "[0].latestReleaseDate"
    }
  },
  "docsLimits": {
    "claudeMdMaxLines": 200,
    "stateFileMaxKB": 50,
    "stateFiles": [
      "docs/EPICS.md",
      "docs/BUGS.md",
      "docs/LESSONS.md",
      "docs/JOURNAL.md",
      "docs/RISKS.md"
    ]
  },
  "rag": {
    "projectDocsThresholdKB": 1024
  }
}
