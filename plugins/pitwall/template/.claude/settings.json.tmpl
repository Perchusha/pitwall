{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/**/.env.development)",
      "Read(/**/.env.production)",
      "Read(/**/.env.test)"
    ]
  },
  "extraKnownMarketplaces": {
    "pitwall": {
      "source": {
        "source": "github",
        "repo": "Perchusha/pitwall"
      }
    }
  },
  "enabledPlugins": {
    "pitwall@pitwall": true
  }
}
